#pragma region VEXcode Generated Robot Configuration
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <math.h>
#include <string.h>


#include "vex.h"

using namespace vex;

// Brain should be defined by default
brain Brain;


// START IQ MACROS
#define waitUntil(condition)                                                   \
  do {                                                                         \
    wait(5, msec);                                                             \
  } while (!(condition))

#define repeat(iterations)                                                     \
  for (int iterator = 0; iterator < iterations; iterator++)
// END IQ MACROS


// Robot configuration code.
inertial BrainInertial = inertial();

#pragma endregion VEXcode Generated Robot Configuration


#include "vex.h"

using namespace vex;

/*
CARD DEALER - MTE 121

Controls (Brain buttons):
  Up / Down  = change a value / scroll the game menu
  Check      = confirm / start / finish
  Right      = go back and re-enter the setup
  Left       = STOP while shuffling or dealing

Sensors used:
  1. Optical sensor (PORT5)  - JAM detection (white card must exit)
  2. Inertial sensor (Brain) - gyro measures base rotation
  3. Brain buttons           - user input + emergency stop
  4. Motor encoders          - feeder degrees per card, base stall
                               check, flywheel-stopped check,
                               shuffler roller travel

Program order: settle gyro -> choose game, players, cards per player
               -> SHUFFLE -> DEAL -> shutdown (press Check)

Course rules followed:
  - NO global variables and NO global constants. The only globals are
    the VEX device objects (VEXcode requires these) and the Settings
    TYPE below (a type definition, not a variable).
  - No break, no infinite loops, no spinFor, no spinToPosition, no
    callbacks.
  - Only VEX functions from the course "VEX IQ Functions" sheet:
    spin, stop, setVelocity, resetPosition, setPosition, position,
    Brain.Screen print/setCursor/clearScreen, Brain button pressing,
    Optical setLight/color/hue, BrainInertial resetRotation/rotation/
    setRotation, printf, wait, Brain.programStop, timer clear/time.
*/


motor baseMotor(PORT6, false);
motor flyWheel(PORT1, true);
motor feedMotor(PORT2, true);
motor shuffleMotor(PORT4, false);   // drives the 2 shuffler rollers
optical OpticalSensor = optical(PORT5);


/*
SETTINGS TYPE
A struct is a bundle of related values. main() makes ONE local copy
(Settings cfg;) and passes it to the functions. Change the numbers
here to tune the robot.
*/

struct Settings {

    // ---- Setup limits ----
    int minPlayers = 2;
    int maxPlayers = 8;
    int deckSize = 52;

    // ---- Games on the menu (ids are the menu positions 0..numGames-1) ----
    int gameGoFish = 0;
    int gameCrazyEights = 1;
    int gameRummy = 2;
    int gameHoldem = 3;
    int gameBlackjack = 4;
    int gameFiveCardDraw = 5;
    int gameHeartsSpades = 6;
    int gameWar = 7;
    int gameCustom = 8;     // user picks players + cards per player
    int numGames = 9;

    // ---- Base rotation (closed loop on the gyro) ----
    double rotateMaxSpeed = 100.0;    // percent
    double rotateMinSpeed = 10.0;     // percent, must still overcome friction
    double rotateKp = 1.2;            // percent of speed per degree of error
    double rotateTolerance = 1.5;     // degrees
    int settleMsec = 100;             // must stay in tolerance this long
    int rotateTimeoutMsec = 6000;
    int stallMsec = 700;              // base not moving this long = stuck
    int stallCheckMsec = 100;         // how often the base encoder is compared
    double stallMinDegrees = 1.0;     // moved less than this per check = not moving

    // ---- Flywheel ----
    double flywheelSpeed = 80.0;
    int flywheelStartupMsec = 400;    // spin-up before EACH card
    int flywheelRunonMsec = 150;      // runs this long after the feeder finishes, then BRAKES
    int flywheelCheckMsec = 50;       // how often the flywheel encoder is compared
    double flywheelStoppedDegrees = 2.0; // moved less than this per check = stopped
    int flywheelStopTimeoutMsec = 1500;

    // ---- Card feeder (one card = feedCardRotation degrees) ----
    double feedSpeed = 100.0;
    double feedCardRotation = 160.0;
    double feedRetractRotation = 50.0; // back off after each card
    double feedHomeTolerance = 10.0;
    int feedTimeoutMsec = 2500;
    int cardExitWindowMsec = 400;
    int unjamTimeoutMsec = 2500;
    int maxFeedAttempts = 4;           // retry a jammed card up to 4 times

    // ---- Optical sensor (jam detection only) ----
    bool opticalJamCheck = true;       // false = skip the check (for testing)

    // ---- Shuffler (one motor, PORT4, turns both rollers) ----
    // One cycle = one stroke forward + one stroke back. There is no
    // sensor that can tell when a deck is "fully shuffled", so the deck
    // counts as shuffled after shuffleCycles cycles (tune by testing).
    double shuffleSpeed = 70.0;          // percent
    double shuffleRotation = 1080.0;     // motor degrees per stroke (3 full turns)
    int shuffleCycles = 10;              // forward+back pairs; 0 = skip shuffling
    int shufflePauseMsec = 150;          // short pause between strokes
    int shuffleStrokeTimeoutMsec = 8000; // a stroke taking longer = stuck

    // ---- Gyro ----
    int gyroSettleMsec = 2000;        // robot must be still this long at start-up
    double gyroMaxDrift = 2.0;        // degrees; more drift than this = gyro error

    // ---- Status codes returned by functions ----
    int ok = 0;
    int stopped = 1;    // user pressed emergency stop
    int jam = 2;        // card never seen (empty hopper or jam)
    int baseErr = 3;    // base stalled or timed out
    int gyroErr = 4;    // gyro drifted while the robot should be still
    int shuffleErr = 5; // shuffler rollers stuck / timed out
};


/* ================================================================
   SMALL HELPERS
   ================================================================ */

/*
Purpose: Absolute value of a number (used instead of fabs, which is
         not on the VEX functions sheet).
Returns : double - x without its sign
Params  : x
*/

double absValue(double x) {
    double result = x;
    if (x < 0) {
        result = -x;
    }
    return result;
}

/*
Purpose: Check the emergency stop button (Left).
Returns : bool - true while the Left button is held
Params  : none
*/

bool stopPressed() {
    return Brain.buttonLeft.pressing();
}

/*
Purpose: Check if the optical sensor sees a white card in front of it.
Returns : bool - true when the sensor reports white
Params  : none
*/

bool isCardWhite() {
    return OpticalSensor.color() == white;
}

/*
Purpose: Show up to two lines of text on the Brain screen.
Returns : nothing
Params  : line1, line2
*/

void showMessage(const char* line1, const char* line2) {
    Brain.Screen.clearScreen();
    Brain.Screen.setCursor(1, 1);
    Brain.Screen.print("%s", line1);
    Brain.Screen.setCursor(3, 1);
    Brain.Screen.print("%s", line2);
}


/* ================================================================
   SETUP (USER INPUT) FUNCTIONS
   ================================================================ */

/*
FUNCTION 1: getSelection
Purpose: Let the user pick a whole number with Up/Down and confirm it
         with Check. Value is clamped to the range so invalid input is
         impossible.
Returns : int - the confirmed value
Params  : label, minValue, maxValue, startValue
*/

int getSelection(const char* label, int minValue, int maxValue, int startValue) {

    int value = startValue;
    if (value < minValue) value = minValue;
    if (value > maxValue) value = maxValue;

    bool confirmed = false;
    bool redraw = true;

    while (!confirmed) {

        if (redraw) {
            Brain.Screen.clearScreen();
            Brain.Screen.setCursor(1, 1);
            Brain.Screen.print("%s", label);
            Brain.Screen.setCursor(3, 1);
            Brain.Screen.print("Value: %d  (%d-%d)", value, minValue, maxValue);
            Brain.Screen.setCursor(5, 1);
            Brain.Screen.print("Up/Down = change");
            Brain.Screen.setCursor(6, 1);
            Brain.Screen.print("Check = confirm");
            redraw = false;
        }

        if (Brain.buttonUp.pressing()) {
            if (value < maxValue) {
                value++;
            }
            redraw = true;
            while (Brain.buttonUp.pressing()) {
                wait(10, msec);
            }
        }
        else if (Brain.buttonDown.pressing()) {
            if (value > minValue) {
                value--;
            }
            redraw = true;
            while (Brain.buttonDown.pressing()) {
                wait(10, msec);
            }
        }
        else if (Brain.buttonCheck.pressing()) {
            confirmed = true;
            while (Brain.buttonCheck.pressing()) {
                wait(10, msec);
            }
        }

        wait(20, msec);
    }

    return value;
}


/*
FUNCTION 2: getGameName
Purpose: Turn a game id into its menu name.
Returns : const char* - the game's name ("Custom" if unknown)
Params  : game (id), cfg
*/

const char* getGameName(int game, Settings cfg) {

    const char* name = "Custom";

    if (game == cfg.gameGoFish) {
        name = "Go Fish";
    }
    else if (game == cfg.gameCrazyEights) {
        name = "Crazy Eights";
    }
    else if (game == cfg.gameRummy) {
        name = "Rummy";
    }
    else if (game == cfg.gameHoldem) {
        name = "Texas Hold'em";
    }
    else if (game == cfg.gameBlackjack) {
        name = "Blackjack";
    }
    else if (game == cfg.gameFiveCardDraw) {
        name = "5-Card Draw";
    }
    else if (game == cfg.gameHeartsSpades) {
        name = "Hearts/Spades";
    }
    else if (game == cfg.gameWar) {
        name = "War";
    }

    return name;
}


/*
FUNCTION 3: getMinPlayers / FUNCTION 4: getMaxPlayers
Purpose: The fewest / most players the chosen game allows (the robot
         itself handles 2 to 8 positions).
Returns : int - the limit
Params  : game (id), cfg
*/

int getMinPlayers(int game, Settings cfg) {

    int minP = cfg.minPlayers;          // most games start at 2 players

    if (game == cfg.gameHeartsSpades) {
        minP = 4;                       // partnership/4-hand games
    }

    return minP;
}

int getMaxPlayers(int game, Settings cfg) {

    int maxP = cfg.maxPlayers;          // Custom, Hold'em, Blackjack: up to 8

    if (game == cfg.gameGoFish) {
        maxP = 6;
    }
    else if (game == cfg.gameCrazyEights) {
        maxP = 7;
    }
    else if (game == cfg.gameRummy) {
        maxP = 6;
    }
    else if (game == cfg.gameFiveCardDraw) {
        maxP = 6;
    }
    else if (game == cfg.gameHeartsSpades) {
        maxP = 4;
    }
    else if (game == cfg.gameWar) {
        maxP = 2;
    }

    return maxP;
}


/*
FUNCTION 5: getCardsPerPlayer
Purpose: How many cards each player gets in the chosen game, which can
         change with the number of players. Never returns more cards
         than the deck can supply.
Returns : int - cards per player
Params  : game (id), numPlayers, cfg
*/

int getCardsPerPlayer(int game, int numPlayers, Settings cfg) {

    int cards = 1;

    if (game == cfg.gameGoFish) {
        cards = (numPlayers <= 3) ? 7 : 5;
    }
    else if (game == cfg.gameCrazyEights) {
        cards = (numPlayers == 2) ? 7 : 5;
    }
    else if (game == cfg.gameRummy) {
        if (numPlayers == 2) {
            cards = 10;
        }
        else if (numPlayers <= 4) {
            cards = 7;
        }
        else {
            cards = 6;
        }
    }
    else if (game == cfg.gameHoldem) {
        cards = 2;                      // hole cards only
    }
    else if (game == cfg.gameBlackjack) {
        cards = 2;                      // dealer counts as a player
    }
    else if (game == cfg.gameFiveCardDraw) {
        cards = 5;
    }
    else if (game == cfg.gameHeartsSpades) {
        cards = 13;                     // whole deck, 4 hands
    }
    else if (game == cfg.gameWar) {
        cards = 26;                     // whole deck, 2 hands
    }

    // safety: never ask for more cards than the deck holds
    if (cards * numPlayers > cfg.deckSize) {
        cards = cfg.deckSize / numPlayers;
    }

    return cards;
}


/*
FUNCTION 6: chooseGame
Purpose: Let the user scroll through the game menu with Up/Down and
         confirm with Check.
Returns : int - the chosen game id
Params  : startGame (id shown first), cfg
*/

int chooseGame(int startGame, Settings cfg) {

    int game = startGame;
    if (game < 0) game = 0;
    if (game > cfg.numGames - 1) game = cfg.numGames - 1;

    bool confirmed = false;
    bool redraw = true;

    while (!confirmed) {

        if (redraw) {
            Brain.Screen.clearScreen();
            Brain.Screen.setCursor(1, 1);
            Brain.Screen.print("Choose a game");
            Brain.Screen.setCursor(3, 1);
            Brain.Screen.print("%s", getGameName(game, cfg));
            Brain.Screen.setCursor(4, 1);
            Brain.Screen.print("(%d of %d)", game + 1, cfg.numGames);
            Brain.Screen.setCursor(5, 1);
            Brain.Screen.print("Up/Down = scroll");
            Brain.Screen.setCursor(6, 1);
            Brain.Screen.print("Check = confirm");
            redraw = false;
        }

        if (Brain.buttonUp.pressing()) {
            if (game > 0) {
                game--;
            }
            redraw = true;
            while (Brain.buttonUp.pressing()) {
                wait(10, msec);
            }
        }
        else if (Brain.buttonDown.pressing()) {
            if (game < cfg.numGames - 1) {
                game++;
            }
            redraw = true;
            while (Brain.buttonDown.pressing()) {
                wait(10, msec);
            }
        }
        else if (Brain.buttonCheck.pressing()) {
            confirmed = true;
            while (Brain.buttonCheck.pressing()) {
                wait(10, msec);
            }
        }

        wait(20, msec);
    }

    return game;
}


/*
FUNCTION 7: confirmSetup
Purpose: Show the chosen setup and the total cards needed.
         Check = start shuffling + dealing, Right = re-enter the setup.
Returns : bool - true to start, false to re-enter
Params  : gameName, numPlayers, cardsPerPlayer
*/

bool confirmSetup(const char* gameName, int numPlayers, int cardsPerPlayer) {

    Brain.Screen.clearScreen();
    Brain.Screen.setCursor(1, 1);
    Brain.Screen.print("Game: %s", gameName);
    Brain.Screen.setCursor(2, 1);
    Brain.Screen.print("Players: %d", numPlayers);
    Brain.Screen.setCursor(3, 1);
    Brain.Screen.print("Cards each: %d", cardsPerPlayer);
    Brain.Screen.setCursor(4, 1);
    Brain.Screen.print("Total cards: %d", numPlayers * cardsPerPlayer);
    Brain.Screen.setCursor(5, 1);
    Brain.Screen.print("Load the cards!");
    Brain.Screen.setCursor(6, 1);
    Brain.Screen.print("Check=START Right=redo");

    bool decided = false;
    bool startDealing = false;

    while (!decided) {

        if (Brain.buttonCheck.pressing()) {
            startDealing = true;
            decided = true;
        }
        else if (Brain.buttonRight.pressing()) {
            startDealing = false;
            decided = true;
        }

        wait(20, msec);
    }

    // wait for the button to be released so it is not seen twice
    while (Brain.buttonCheck.pressing() || Brain.buttonRight.pressing()) {
        wait(10, msec);
    }

    return startDealing;
}


/*
FUNCTION 8: getDealSetup
Purpose: Collect the whole deal setup from the user:
           1. choose a game (or Custom),
           2. enter the NUMBER OF PLAYERS (skipped only if the game
              allows exactly one value, e.g. War = 2),
           3. enter CARDS PER PLAYER (Custom), or have it filled in
              automatically from the game's rules,
           4. confirm on the summary screen.
         Pressing Right on the summary screen starts the setup again,
         so the user can always fix a mistake before dealing begins.
         Values are clamped by getSelection, so players * cards can
         never be more than the deck size.
Returns : nothing - the results are passed back through the two
          reference parameters
Params  : numPlayers (in: value shown first, out: chosen value),
          cardsPerPlayer (in: value shown first, out: chosen value),
          cfg (settings)
*/

void getDealSetup(int & numPlayers, int & cardsPerPlayer, Settings cfg) {

    int game = cfg.gameGoFish;
    bool ready = false;

    while (!ready) {

        game = chooseGame(game, cfg);

        int minP = getMinPlayers(game, cfg);
        int maxP = getMaxPlayers(game, cfg);

        if (minP == maxP) {
            numPlayers = minP;          // game has a fixed number of players
        }
        else {
            numPlayers = getSelection("How many players?",
                                      minP, maxP, numPlayers);
        }

        if (game == cfg.gameCustom) {
            // never allow more cards than are in the deck
            int maxCards = cfg.deckSize / numPlayers;
            cardsPerPlayer = getSelection("Cards per player?",
                                          1, maxCards, cardsPerPlayer);
        }
        else {
            cardsPerPlayer = getCardsPerPlayer(game, numPlayers, cfg);
        }

        ready = confirmSetup(getGameName(game, cfg), numPlayers, cardsPerPlayer);
    }

    printf("Setup: %s, %d players, %d cards each\n",
           getGameName(game, cfg), numPlayers, cardsPerPlayer);
}


/* ================================================================
   ROBOT FUNCTIONS
   ================================================================ */

/*
FUNCTION 9: initializeRobot
Purpose: Set motor speeds, make sure nothing is spinning, zero the
         encoders, turn on the optical light, and check the gyro. The
         robot must be still: the gyro is zeroed, we wait
         gyroSettleMsec, and if it has drifted more than gyroMaxDrift
         degrees the gyro is reported as faulty.
Returns : bool - true if the gyro is steady
Params  : cfg (settings)
*/

bool initializeRobot(Settings cfg) {

    baseMotor.setVelocity(cfg.rotateMaxSpeed, percent);
    feedMotor.setVelocity(cfg.feedSpeed, percent);
    shuffleMotor.setVelocity(cfg.shuffleSpeed, percent);

    // make sure nothing is spinning from a previous run
    flyWheel.stop(brake);
    shuffleMotor.stop(brake);
    baseMotor.stop(hold);
    feedMotor.stop(hold);

    baseMotor.resetPosition();
    feedMotor.resetPosition();
    flyWheel.resetPosition();
    shuffleMotor.resetPosition();

    OpticalSensor.setLight(ledState::on);

    showMessage("Checking gyro...", "Keep robot still");

    BrainInertial.resetRotation();
    wait(cfg.gyroSettleMsec, msec);

    bool gyroSteady = absValue(BrainInertial.rotation(degrees)) <= cfg.gyroMaxDrift;

    BrainInertial.setRotation(0, degrees);

    return gyroSteady;
}


/*
FUNCTION 10: rotateBase
Purpose: Turn the base to an ABSOLUTE gyro heading for the given stop
         number (stopNumber * 360 / numPlayers). Using an absolute
         heading means small errors never add up from one player to
         the next. Slows down as it approaches the target. A stall is
         found by comparing the base motor encoder every
         stallCheckMsec: if it barely moved for stallMsec the base is
         stuck. A timeout catches anything else.
Returns : int - cfg.ok, cfg.stopped or cfg.baseErr
Params  : stopNumber (how many moves so far), numPlayers, cfg
*/

int rotateBase(int stopNumber, int numPlayers, Settings cfg) {

    double target = stopNumber * (360.0 / numPlayers);

    timer moveTimer;
    moveTimer.clear();

    int stableMsec = 0;
    int stalledMsec = 0;
    int windowMsec = 0;
    double lastBasePosition = baseMotor.position(degrees);
    int result = cfg.ok;

    while (stableMsec < cfg.settleMsec && result == cfg.ok) {

        if (stopPressed()) {
            result = cfg.stopped;
        }
        else if (moveTimer.time(msec) > cfg.rotateTimeoutMsec) {
            result = cfg.baseErr;
        }
        else {
            double heading = absValue(BrainInertial.rotation(degrees));
            double error = target - heading;

            if (absValue(error) <= cfg.rotateTolerance) {
                baseMotor.stop(hold);
                stableMsec += 5;
                stalledMsec = 0;
                windowMsec = 0;
                lastBasePosition = baseMotor.position(degrees);
            }
            else {
                stableMsec = 0;

                // proportional speed with a minimum so it never stalls
                double magnitude = absValue(error) * cfg.rotateKp;
                if (magnitude > cfg.rotateMaxSpeed) magnitude = cfg.rotateMaxSpeed;
                if (magnitude < cfg.rotateMinSpeed) magnitude = cfg.rotateMinSpeed;

                if (error > 0) {
                    baseMotor.spin(forward, magnitude, percent);
                }
                else {
                    baseMotor.spin(reverse, magnitude, percent);
                }

                // motor encoder: detect a jammed base
                windowMsec += 5;
                if (windowMsec >= cfg.stallCheckMsec) {
                    double basePosition = baseMotor.position(degrees);

                    if (absValue(basePosition - lastBasePosition) < cfg.stallMinDegrees) {
                        stalledMsec += windowMsec;
                    }
                    else {
                        stalledMsec = 0;
                    }

                    lastBasePosition = basePosition;
                    windowMsec = 0;
                }

                if (stalledMsec >= cfg.stallMsec) {
                    result = cfg.baseErr;
                }
            }

            wait(5, msec);
        }
    }

    baseMotor.stop(hold);
    return result;
}


/*
FUNCTION 11: spinUpFlywheel
Purpose: Start the flywheel and wait for it to reach speed, while still
         watching the emergency stop.
Returns : int - cfg.ok or cfg.stopped
Params  : cfg (settings)
*/

int spinUpFlywheel(Settings cfg) {

    flyWheel.spin(forward, cfg.flywheelSpeed, percent);

    int elapsed = 0;
    int result = cfg.ok;

    while (elapsed < cfg.flywheelStartupMsec && result == cfg.ok) {

        if (stopPressed()) {
            result = cfg.stopped;
        }

        wait(10, msec);
        elapsed += 10;
    }

    return result;
}


/*
FUNCTION 12: stopFlywheel
Purpose: BRAKE the flywheel (not coast) and wait until the flywheel
         encoder shows it has really stopped (it moves less than
         flywheelStoppedDegrees between two checks), so the base never
         turns while the wheel is still spinning.
Returns : int - cfg.ok or cfg.stopped
Params  : cfg (settings)
*/

int stopFlywheel(Settings cfg) {

    flyWheel.stop(brake);

    timer stopTimer;
    stopTimer.clear();

    int result = cfg.ok;
    bool wheelStopped = false;
    double lastPosition = flyWheel.position(degrees);

    while (!wheelStopped &&
           stopTimer.time(msec) < cfg.flywheelStopTimeoutMsec &&
           result == cfg.ok) {

        wait(cfg.flywheelCheckMsec, msec);

        double newPosition = flyWheel.position(degrees);
        if (absValue(newPosition - lastPosition) < cfg.flywheelStoppedDegrees) {
            wheelStopped = true;
        }
        lastPosition = newPosition;

        if (stopPressed()) {
            result = cfg.stopped;
        }
    }

    return result;
}


/*
FUNCTION 13: feedCard
Purpose: Push out ONE card by spinning the feed motor feedCardRotation
         degrees (measured with the motor encoder). The optical sensor
         is watched during the push and for a short window afterwards;
         if it never sees the white card leave, the card is reported as
         jammed. The flywheel brakes shortly after the feeder finishes.
Returns : int - cfg.ok, cfg.stopped or cfg.jam
Params  : cfg (settings)
*/

int feedCard(Settings cfg) {

    timer feedTimer;
    feedTimer.clear();

    int result = cfg.ok;
    bool cardSeen = false;
    bool flywheelOff = false;

    feedMotor.setPosition(0, degrees);
    feedMotor.spin(forward, cfg.feedSpeed, percent);

    // Phase 1: spin until the encoder reaches the card distance
    while (absValue(feedMotor.position(degrees)) < cfg.feedCardRotation &&
           result == cfg.ok) {

        if (stopPressed()) {
            result = cfg.stopped;
        }
        else if (feedTimer.time(msec) > cfg.feedTimeoutMsec) {
            result = cfg.jam;   // feeder could not turn far enough
        }

        if (isCardWhite()) {
            cardSeen = true;
        }

        wait(5, msec);
    }

    feedMotor.stop(hold);

    // Phase 2: give the card time to leave, still watching the sensor
    feedTimer.clear();

    while (feedTimer.time(msec) < cfg.cardExitWindowMsec && result == cfg.ok) {

        // flywheel only runs a moment after the feeder finishes, then brakes
        if (!flywheelOff && feedTimer.time(msec) >= cfg.flywheelRunonMsec) {
            flyWheel.stop(brake);
            flywheelOff = true;
        }

        if (stopPressed()) {
            result = cfg.stopped;
        }

        if (isCardWhite()) {
            cardSeen = true;
        }

        wait(5, msec);
    }

    if (result == cfg.ok && cfg.opticalJamCheck && !cardSeen) {
        result = cfg.jam;
    }

    return result;
}


/*
FUNCTION 14: unjamFeeder
Purpose: Recover from a jam. Reverses the feeder (back to its start
         position, measured by the encoder) and the flywheel, then
         brakes the flywheel. (dealOneCard spins it up again for the
         next attempt.)
Returns : int - cfg.ok or cfg.stopped
Params  : cfg (settings)
*/

int unjamFeeder(Settings cfg) {

    showMessage("Jam detected", "Reversing + retrying");

    timer unjamTimer;
    unjamTimer.clear();

    int result = cfg.ok;

    flyWheel.spin(reverse, cfg.flywheelSpeed, percent);
    feedMotor.spin(reverse, cfg.feedSpeed, percent);

    while (absValue(feedMotor.position(degrees)) > cfg.feedHomeTolerance &&
           unjamTimer.time(msec) < cfg.unjamTimeoutMsec &&
           result == cfg.ok) {

        if (stopPressed()) {
            result = cfg.stopped;
        }

        wait(5, msec);
    }

    feedMotor.stop(hold);

    int stopResult = stopFlywheel(cfg);
    if (result == cfg.ok) {
        result = stopResult;
    }

    return result;
}


/*
FUNCTION 15: retractFeeder
Purpose: After a card has been dealt (flywheel already stopped), back
         the feeder off by feedRetractRotation degrees so the next card
         is not pushed all the way to the exit. Uses the feed motor
         encoder.
Returns : int - cfg.ok or cfg.stopped
Params  : cfg (settings)
*/

int retractFeeder(Settings cfg) {

    timer retractTimer;
    retractTimer.clear();

    int result = cfg.ok;
    double retractTarget = cfg.feedCardRotation - cfg.feedRetractRotation;

    feedMotor.spin(reverse, cfg.feedSpeed, percent);

    while (absValue(feedMotor.position(degrees)) > retractTarget &&
           retractTimer.time(msec) < cfg.unjamTimeoutMsec &&
           result == cfg.ok) {

        if (stopPressed()) {
            result = cfg.stopped;
        }

        wait(5, msec);
    }

    feedMotor.stop(hold);
    return result;
}


/*
FUNCTION 16: dealOneCard
Purpose: Deal exactly one card. The flywheel is ONLY running while the
         card is being fed: spin up -> feed -> stop. If the optical
         sensor says the card did not exit, reverse and try again, up
         to maxFeedAttempts times (handles the "unexpected input" of a
         jammed card). After a good deal the feeder is backed off.
Returns : int - cfg.ok, cfg.stopped or cfg.jam
Params  : cfg (settings)
*/

int dealOneCard(Settings cfg) {

    int result = cfg.jam;
    int attempt = 0;

    while (result == cfg.jam && attempt < cfg.maxFeedAttempts) {

        result = spinUpFlywheel(cfg);

        if (result == cfg.ok) {
            result = feedCard(cfg);
        }

        // flywheel only runs while dealing: brake and wait until it has stopped
        int stopResult = stopFlywheel(cfg);
        if (stopResult != cfg.ok) {
            result = stopResult;
        }
        attempt++;

        if (result == cfg.jam) {
            printf("Jam on attempt %d of %d\n", attempt, cfg.maxFeedAttempts);
        }

        if (result == cfg.jam && attempt < cfg.maxFeedAttempts) {
            int unjamResult = unjamFeeder(cfg);

            if (unjamResult != cfg.ok) {
                result = unjamResult;   // user stopped during recovery
            }
        }
    }

    if (result == cfg.ok) {
        result = retractFeeder(cfg);
    }

    return result;
}


/*
FUNCTION 17: showDealStatus
Purpose: Update the Brain screen during dealing, including the live
         optical hue so the card detection can be checked/calibrated.
Returns : nothing
Params  : cardsDealt, totalCards, playerNumber
*/

void showDealStatus(int cardsDealt, int totalCards, int playerNumber) {

    Brain.Screen.clearScreen();
    Brain.Screen.setCursor(1, 1);
    Brain.Screen.print("DEALING");
    Brain.Screen.setCursor(2, 1);
    Brain.Screen.print("Card %d of %d", cardsDealt + 1, totalCards);
    Brain.Screen.setCursor(3, 1);
    Brain.Screen.print("To player %d", playerNumber);
    Brain.Screen.setCursor(4, 1);
    Brain.Screen.print("Hue: %.0f", OpticalSensor.hue());
    Brain.Screen.setCursor(6, 1);
    Brain.Screen.print("Left = STOP");
}


/*
FUNCTION 18: dealAllCards
Purpose: Main dealing routine. Deals cardsPerPlayer rounds around the
         table. After every card the base turns to the next player;
         after the last card the base has made complete turns and is
         back at its start position.
Returns : int - cfg.ok or the error/stop code that ended it
Params  : numPlayers, cardsPerPlayer, cfg
*/

int dealAllCards(int numPlayers, int cardsPerPlayer, Settings cfg) {

    int totalCards = numPlayers * cardsPerPlayer;
    int cardsDealt = 0;
    int status = cfg.ok;

    while (status == cfg.ok && cardsDealt < totalCards) {

        int playerNumber = (cardsDealt % numPlayers) + 1;
        showDealStatus(cardsDealt, totalCards, playerNumber);

        status = dealOneCard(cfg);

        if (status == cfg.ok) {
            cardsDealt++;
            printf("Card %d of %d dealt to player %d\n",
                   cardsDealt, totalCards, playerNumber);
            status = rotateBase(cardsDealt, numPlayers, cfg);
        }
    }

    return status;
}


/*
FUNCTION 19: shuffleStroke
Purpose: Turn the shuffler rollers ONE stroke: spin the shuffler motor
         (PORT4) in the chosen direction until its encoder has
         travelled shuffleRotation degrees, then brake. A timeout
         catches stuck rollers; Left stops it.
Returns : int - cfg.ok, cfg.stopped or cfg.shuffleErr
Params  : spinForward (true = forward, false = reverse), cfg
*/

int shuffleStroke(bool spinForward, Settings cfg) {

    timer strokeTimer;
    strokeTimer.clear();

    int result = cfg.ok;

    shuffleMotor.setPosition(0, degrees);

    if (spinForward) {
        shuffleMotor.spin(forward, cfg.shuffleSpeed, percent);
    }
    else {
        shuffleMotor.spin(reverse, cfg.shuffleSpeed, percent);
    }

    // position counts up going forward and down going reverse, so use absValue
    while (absValue(shuffleMotor.position(degrees)) < cfg.shuffleRotation &&
           result == cfg.ok) {

        if (stopPressed()) {
            result = cfg.stopped;
        }
        else if (strokeTimer.time(msec) > cfg.shuffleStrokeTimeoutMsec) {
            result = cfg.shuffleErr;
        }

        wait(5, msec);
    }

    shuffleMotor.stop(brake);
    return result;
}


/*
FUNCTION 20: shuffleCards
Purpose: Shuffle the deck by running the rollers forward then reverse,
         shuffleCycles times, showing progress on the Brain screen. The
         shuffler motor is stopped when it is finished (or if anything
         goes wrong). Set shuffleCycles to 0 to skip shuffling.
Returns : int - cfg.ok or the error/stop code that ended it
Params  : cfg (settings)
*/

int shuffleCards(Settings cfg) {

    int result = cfg.ok;
    int cycle = 0;

    while (cycle < cfg.shuffleCycles && result == cfg.ok) {

        Brain.Screen.clearScreen();
        Brain.Screen.setCursor(1, 1);
        Brain.Screen.print("SHUFFLING");
        Brain.Screen.setCursor(2, 1);
        Brain.Screen.print("Pass %d of %d", cycle + 1, cfg.shuffleCycles);
        Brain.Screen.setCursor(6, 1);
        Brain.Screen.print("Left = STOP");

        result = shuffleStroke(true, cfg);      // rollers forward

        if (result == cfg.ok) {
            wait(cfg.shufflePauseMsec, msec);
            result = shuffleStroke(false, cfg); // rollers reverse
        }

        if (result == cfg.ok) {
            wait(cfg.shufflePauseMsec, msec);
            cycle++;
        }
    }

    shuffleMotor.stop(brake);
    return result;
}


/*
FUNCTION 21: shutdownRobot
Purpose: Stop every motor, turn off the optical light, tell the user how
         the run ended, wait for Check, then end the program with
         Brain.programStop(). This is the normal shutdown (no need to
         hit abort/back).
Returns : nothing
Params  : status (a status code), cfg
*/

void shutdownRobot(int status, Settings cfg) {

    baseMotor.stop(hold);
    feedMotor.stop(hold);
    flyWheel.stop(brake);
    shuffleMotor.stop(brake);
    OpticalSensor.setLight(ledState::off);

    if (status == cfg.ok) {
        showMessage("Dealing complete!", "All cards dealt");
    }
    else if (status == cfg.stopped) {
        showMessage("Stopped by user", "Motors stopped");
    }
    else if (status == cfg.jam) {
        showMessage("Card not exiting", "Empty hopper or jam");
    }
    else if (status == cfg.baseErr) {
        showMessage("Base stuck/timeout", "Check the turntable");
    }
    else if (status == cfg.shuffleErr) {
        showMessage("Shuffler stuck", "Check the rollers");
    }
    else {
        showMessage("Gyro drifting", "Keep still, restart");
    }

    printf("Shutdown with status %d\n", status);

    Brain.Screen.setCursor(5, 1);
    Brain.Screen.print("Press Check to exit");

    while (!Brain.buttonCheck.pressing()) {
        wait(20, msec);
    }

    Brain.Screen.clearScreen();
    Brain.programStop();
}


/* ================================================================
   MAIN
   ================================================================ */

int main() {

    Settings cfg;   // local copy of all tuning values + status codes

    int status = cfg.ok;

    if (!initializeRobot(cfg)) {
        status = cfg.gyroErr;
    }
    else {

        int numPlayers = 4;       // first value shown on the players screen
        int cardsPerPlayer = 1;   // first value shown on the cards screen

        getDealSetup(numPlayers, cardsPerPlayer, cfg);

        // shuffle first, then deal (dealing only starts if shuffling went fine)
        status = shuffleCards(cfg);

        if (status == cfg.ok) {
            status = dealAllCards(numPlayers, cardsPerPlayer, cfg);
        }
    }

    shutdownRobot(status, cfg);

    return 0;
}
